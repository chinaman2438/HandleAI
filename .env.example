# ==============================================================================
# Meridian Receivables Portal — Environment Variables (.env.example)
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real secrets to Git!
# ==============================================================================

# 1. Supabase Public Configuration (Required for Supabase Auth / Storage client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# 2. Supabase Server / Database Configuration
# When SUPABASE_DB_URL is set, the portal connects to remote Supabase Postgres.
# When omitted, the portal automatically runs an embedded PostgreSQL engine (PGlite)
# with the exact same migrations, Row Level Security (RLS) policies, and seeded workbook.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# 3. Optional Reminder & Email Configuration
# When RESEND_API_KEY is omitted, reminders run in Demo / In-Portal mode
# (recorded as status='generated', sent_at=NULL).
RESEND_API_KEY=
REMINDER_FROM_EMAIL=receivables@meridian.demo
REMINDER_DEFAULT_DAYS_BEFORE=3
CRON_SECRET=meridian-cron-secret
